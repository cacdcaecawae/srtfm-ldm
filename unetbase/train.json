{
  "seed": null,
  "device": "cuda",
  "data": {
    "batch_size": 32,
    "num_workers": 4,
    "image_size": 400,
    "channels": 1,
    "h5_path": "./data/output_merge/train.h5",
    "h5_lr_key": "TFM",
    "h5_hr_key": "hr",
    "h5_lr_dataset": "intensity",
    "transpose_lr": true,
    "transpose_hr": true,
    "use_tfm_channels": true,
    "coord_range_x": [-0.012000, 0.012000],
    "coord_range_y": [0.001000, 0.039000],
    "augment": false,
    "h_flip_prob": 0.5,
    "translate_prob": 0.5,
    "max_translate_ratio": 0.05
  },
  "model": {
    "module": "network",
    "backbone": "unet_res",
    "checkpoint_dir": "SR/weight_ckpt",
    "checkpoint_name": "I2sb1229-ode.pth"
  },
  "optimization": {
    "epochs": 1000,
    "ema_decay": 0.99,
    "learning_rate": 0.0001,
    "betas": [
      0.9,
      0.99
    ],
    "weight_decay": 0.001,
    "warmup_epochs": 50,
    "lr_min": 1e-06,
    "lr_max": 0.0005,
    "amp": true,
    "amp_dtype": "bfloat16",
    "clip_grad_norm": 1.0
  },
  "logging": {
    "tensorboard_root": "runs",
    "experiment_name": "unetonly-train",
    "sample_interval": 10,
    "num_preview_samples": 4
  }
}
